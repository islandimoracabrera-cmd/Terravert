.btn-deny { display: flex; align-items: center; gap: 5px; padding: 8px 14px; border-radius: 8px; background: rgba(239, 68, 68, 0.094); border: 1px solid rgba(239, 68, 68, 0.2); color: rgb(239, 68, 68); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: 0.15s; }

.btn-deny:hover { background: rgba(239, 68, 68, 0.157); }

