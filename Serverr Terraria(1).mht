.card-stats { display: flex; align-items: center; gap: 6px; }

.save-toast { position: fixed; bottom: 80px; left: 50%; transform: translate(-50%); background: var(--accent); color: rgb(255, 255, 255); font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: 10px; z-index: 999; white-space: nowrap; animation: 0.2s ease 0s 1 normal none running toastIn; }

