.pending-badge { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px; background: rgba(245, 158, 11, 0.133); color: rgb(245, 158, 11); border: 1px solid rgba(245, 158, 11, 0.2); margin-left: 4px; }

