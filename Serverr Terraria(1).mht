.search-input { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--text); font-size: 14px; flex: 1 1 0%; outline: none; font-family: inherit; }

.search-input::placeholder { color: var(--muted); }

.cat-tabs { display: flex; gap: 6px; margin-bottom: 18px; flex-wrap: wrap; }

.cat-tab { padding: 6px 14px; border-radius: 8px; border: 1px solid var(--border2); background: var(--card2); color: var(--muted); font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit; transition: 0.15s; }

.cat-tab:hover { color: var(--text); }

.cat-tab-active { background: var(--accent) !important; border-color: var(--accent) !important; color: rgb(255, 255, 255) !important; }

.refresh-badge { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--muted); }

.empty-state { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 60px 20px; color: var(--muted); text-align: center; }

.server-photos { position: relative; width: 100%; height: 150px; border-radius: 10px; overflow: hidden; margin-bottom: 10px; background: var(--card2); }

.server-photo { width: 100%; height: 100%; object-fit: cover; display: block; }

.photo-nav { position: absolute; bottom: 8px; left: 50%; transform: translate(-50%); display: flex; align-items: center; gap: 6px; background: rgba(8, 11, 16, 0.75); border-radius: 20px; padding: 3px 8px; }

.photo-nav-btn { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: rgb(255, 255, 255); cursor: pointer; padding: 2px; display: flex; align-items: center; border-radius: 4px; }

.photo-counter { font-size: 11px; color: rgb(255, 255, 255); font-weight: 600; }

.photos-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }

.btn-add-photo { display: flex; align-items: center; gap: 4px; background: none; border: 1px solid var(--border2); color: var(--muted); font-size: 11px; padding: 4px 9px; border-radius: 6px; cursor: pointer; font-family: inherit; transition: 0.15s; }

.btn-add-photo:hover { border-color: var(--accent); color: var(--accent); }

.photo-inputs { display: flex; flex-direction: column; gap: 6px; }

.photo-input-row { display: flex; gap: 6px; align-items: center; }

.photo-input-row input { flex: 1 1 0%; }

.btn-remove-photo { background: none; border: 1px solid var(--border2); color: var(--muted); padding: 6px 7px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; font-family: inherit; transition: 0.15s; flex-shrink: 0; }

.btn-remove-photo:hover { border-color: var(--danger); color: var(--danger); }

.splash { position: fixed; inset: 0px; background: url("https://i.postimg.cc/xjKhM3DX/1778182548886.png") center center / cover rgb(6, 10, 15); display: flex; align-items: center; justify-content: center; z-index: 9999; transition: opacity 0.5s; }

.splash-fade { opacity: 0; pointer-events: none; }

.splash::before { content: ""; position: absolute; inset: 0px; background: rgba(6, 10, 15, 0.82); }

.splash-inner { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; animation: 0.6s ease 0s 1 normal both running splashIn; }

@keyframes splashIn { 
  0% { opacity: 0; transform: translateY(16px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.splash-logo { margin-bottom: 4px; filter: drop-shadow(rgba(22, 163, 74, 0.4) 0px 0px 20px); }

.splash-title { font-size: 38px; font-weight: 900; letter-spacing: 0.18em; color: rgb(226, 232, 244); text-shadow: rgba(22, 163, 74, 0.333) 0px 0px 30px; }

.splash-sub { font-size: 15px; font-weight: 600; color: var(--accent); letter-spacing: 0.06em; }

.splash-community { font-size: 12px; color: var(--muted); letter-spacing: 0.04em; }

.splash-version { font-size: 11px; color: rgba(59, 130, 246, 0.4); font-family: monospace; margin-top: 4px; }

.splash-dots { display: flex; gap: 6px; margin-top: 12px; }

.splash-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: 1.2s ease-in-out 0s infinite normal none running dot; }

.splash-dots span:nth-child(2) { animation-delay: 0.2s; }

.splash-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes dot { 
  0%, 80%, 100% { opacity: 0.2; transform: scale(0.7); }
  40% { opacity: 1; transform: scale(1); }
}

.brand-block { display: flex; flex-direction: column; line-height: 1; }

.brand-tagline { font-size: 9px; font-weight: 500; color: var(--muted); letter-spacing: 0.04em; }

.pending-notice { background: rgba(245, 158, 11, 0.082); border: 1px solid rgba(245, 158, 11, 0.2); color: rgb(245, 158, 11); font-size: 12px; padding: 9px 13px; border-radius: 9px; margin-bottom: 12px; }

@media (max-width: 600px) {
  .mobile-tabs { display: flex; }
