.fav-btn { margin-left: auto; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: var(--muted); cursor: pointer; padding: 4px; border-radius: 6px; transition: color 0.15s; }

.fav-btn:hover { color: rgb(245, 158, 11); }

